{
  "version": 1,
  "manager": "npm",
  "tsconfigs": [
    "tsconfig.app.json",
    "tsconfig.node.json"
  ],
  "gates": [
    {
      "name": "lint",
      "command": [
        "npm",
        "run",
        "lint"
      ]
    },
    {
      "name": "types",
      "command": [
        "node",
        "scripts/maintenance/typecheck.mjs",
        "tsconfig.app.json",
        "tsconfig.node.json"
      ]
    },
    {
      "name": "test",
      "command": [
        "node",
        "node_modules/vitest/vitest.mjs",
        "run",
        "--maxWorkers=1"
      ]
    },
    {
      "name": "build",
      "command": [
        "npm",
        "run",
        "build"
      ]
    }
  ],
  "fix": {
    "roots": [
      "src"
    ],
    "eslintRules": [
      "eol-last",
      "no-trailing-spaces",
      "object-curly-spacing"
    ],
    "prettier": false
  },
  "timeoutMs": 300000,
  "maxFiles": 20,
  "maxChangedLines": 400
}
