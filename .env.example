# ============================================================================
# FAST GRAVA ES - VARIÁVEIS DE AMBIENTE
# ============================================================================
# Copie este arquivo para .env.local e preencha os valores reais

# Supabase (OBRIGATÓRIO)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PROJECT_ID=seu-project-id
# O client lê VITE_SUPABASE_PUBLISHABLE_KEY (chave publishable/anon)
VITE_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key

# Bitrix24 — NÃO configurar aqui. A integração roda server-side na Edge
# Function `bitrix24-sync` via Deno.env: BITRIX24_DOMAIN, BITRIX24_WEBHOOK_URL,
# BITRIX24_WEBHOOK_SECRET, BITRIX24_CLIENT_ID/SECRET (supabase secrets set).
# Nenhuma variável VITE_* de Bitrix é lida pelo frontend.

# Email (Resend) e SMS/WhatsApp (Twilio) — server-side apenas (Deno.env nas
# Edge Functions: RESEND_API_KEY, TWILIO_*). Chaves de API NUNCA vão em VITE_*:
# tudo prefixado VITE_ é embutido no bundle e vira público.

# Ambiente
VITE_APP_ENV=development
VITE_APP_DEBUG=true

# Google (opcional)
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_ANALYTICS_ID=

# Sentry (opcional - monitoramento)
VITE_SENTRY_DSN=

# Webhook de alertas críticos (opcional; lido por src/lib/logger.ts).
# ATENÇÃO: a URL costuma embutir token — qualquer valor VITE_* é público no
# bundle. Use endpoint dedicado sem token sensível ou redirecione via Edge Function.
VITE_ALERT_WEBHOOK_URL=
