# ============================================================================
# FAST GRAVAÇÕES ES — Ambiente STAGING (template)
# ============================================================================
# NÃO COMITAR VALORES REAIS. Cópia local: `.env.staging.local` (gitignored).

# --- Supabase (OBRIGATÓRIO) --------------------------------------------------
VITE_APP_ENV=staging
VITE_APP_DEBUG=true
VITE_SUPABASE_URL=https://your-staging.supabase.co
VITE_SUPABASE_PROJECT_ID=your-staging-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-staging-publishable-key

# --- Bitrix24 (server-side apenas, sandbox) -----------------------------------
# Integração roda na Edge Function bitrix24-sync via Deno.env — NÃO usar VITE_*.

# --- Email / SMS / WhatsApp (server-side apenas, contas de teste) -------------
# RESEND_API_KEY e TWILIO_* vivem em Supabase secrets (Deno.env).
# VITE_* é público no bundle: nunca colocar chave de API aqui.

# --- Observabilidade --------------------------------------------------------
VITE_SENTRY_DSN=

# --- Google (opcional) ------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_ANALYTICS_ID=

# --- Webhook de alertas críticos (opcional) ---------------------------------
VITE_ALERT_WEBHOOK_URL=
